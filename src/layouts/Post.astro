---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import Page from './Page.astro';

type Props = CollectionEntry<'writing'>['data'];

const { title, description, pubDate, updatedDate, heroImage, wip, draft, meta } = Astro.props;
---

<Page
	title={`${title} - ${SITE_TITLE}`}
	description={description}
	image={heroImage}
	back={{ href: '/writing/', label: 'Writing' }}
>
	<article>
		<header>
			<h1>{title}</h1>
			<p class="dek">{description}</p>
			{wip && <p class="flag">Work in progress: results and text may change.</p>}
			{draft && <p class="flag">Draft: only visible in dev, never published.</p>}
			<div class="meta">
				<div><b>Author</b>{SITE_TITLE}</div>
				<div><b>Published</b><FormattedDate date={pubDate} /></div>
				{
					updatedDate && (
						<div>
							<b>Updated</b>
							<FormattedDate date={updatedDate} />
						</div>
					)
				}
				{
					Object.entries(meta).map(([label, value]) => (
						<div>
							<b>{label}</b>
							{value}
						</div>
					))
				}
			</div>
		</header>
		{
			heroImage && (
				<figure class="hero bleed">
					<Image src={heroImage} width={1680} alt="" />
				</figure>
			)
		}
		<slot />
	</article>
</Page>

<style>
	header {
		padding: 48px 0 8px;
	}
	.dek {
		font-size: 21px;
		line-height: 1.5;
		color: var(--muted);
		margin: 0 0 28px;
	}
	.flag {
		font: 500 13.5px/1.4 var(--sans);
		color: var(--warn);
		margin: -14px 0 24px;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 32px;
		padding: 16px 0;
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		font: 400 14px/1.4 var(--sans);
		color: var(--muted);
	}
	.meta b {
		display: block;
		font: 600 11px/1 var(--sans);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink);
		margin-bottom: 5px;
	}
	.hero {
		--bleed: 840px;
		margin: 36px 0 0;
	}
	@media (max-width: 600px) {
		header {
			padding-top: 32px;
		}
		.dek {
			font-size: 18.5px;
		}
		.meta {
			gap: 10px 24px;
		}
	}
</style>
