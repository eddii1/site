---
/**
 * How long Grok took per decision on real flights: a histogram in 0.5 s bins, last bin open-ended.
 * Data: src/data/seek-decisions.json, exported from the SEEK run logs.
 */
import data from '../../../data/seek-decisions.json';

const secs = data.decisions.filter((d) => d.real).map((d) => d.s);
const sorted = [...secs].sort((a, b) => a - b);
const median = sorted[Math.floor(sorted.length / 2)];

const BIN = 0.5;
const LO = 1;
const HI = 8; // everything at or above HI goes in the last bin
const bins = Array.from({ length: (HI - LO) / BIN + 1 }, (_, i) => ({
	from: LO + i * BIN,
	open: i === (HI - LO) / BIN,
	n: 0,
}));
for (const s of secs) {
	const i = Math.min(bins.length - 1, Math.max(0, Math.floor((s - LO) / BIN)));
	bins[i].n++;
}
const label = (b: (typeof bins)[number]) => (b.open ? `${b.from} s or more` : `${b.from}-${b.from + BIN} s`);

// Geometry (viewBox units; the SVG scales to the column width)
const W = 720;
const H = 260;
const pad = { l: 36, r: 8, t: 16, b: 36 };
const slot = (W - pad.l - pad.r) / bins.length;
const barW = Math.min(24, slot - 2);
const max = Math.max(...bins.map((b) => b.n));
const top = Math.ceil(max / 10) * 10;
const y = (n: number) => pad.t + (H - pad.t - pad.b) * (1 - n / top);
const ticks = [0, top / 2, top];
const x = (s: number) => pad.l + ((s - LO) / BIN) * slot; // left edge of the bin that starts at s
const medianX = x(median);
const r = 4;
const bar = (bx: number, by: number, h: number) =>
	h <= r
		? `M${bx},${by + h}V${by}H${bx + barW}V${by + h}Z`
		: `M${bx},${by + h}V${by + r}Q${bx},${by} ${bx + r},${by}H${bx + barW - r}Q${bx + barW},${by} ${bx + barW},${by + r}V${by + h}Z`;
---

<figure class="chart">
	<div class="fig-head">
		<span>Seconds per Grok decision, real flights</span>
		<span class="sub">{secs.length} decisions</span>
	</div>
	<div class="plot" data-chart>
		<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Histogram of ${secs.length} decision times. Median ${median} seconds.`}>
			{
				ticks.map((t) => (
					<g>
						<line x1={pad.l} x2={W - pad.r} y1={y(t)} y2={y(t)} class="grid" />
						<text x={pad.l - 8} y={y(t) + 4} class="tick" text-anchor="end">
							{t}
						</text>
					</g>
				))
			}
			{
				bins.map((b, i) => {
					const bx = pad.l + i * slot + (slot - barW) / 2;
					const by = y(b.n);
					const h = H - pad.b - by;
					return (
						<g class="col" data-tip={`${label(b)}: ${b.n} decision${b.n === 1 ? '' : 's'}`}>
							<rect x={pad.l + i * slot} y={pad.t} width={slot} height={H - pad.t - pad.b} class="hit" />
							{b.n > 0 && <path d={bar(bx, by, h)} class="mark" />}
						</g>
					);
				})
			}
			<line x1={medianX} x2={medianX} y1={pad.t} y2={H - pad.b} class="median" />
			<text x={medianX + 6} y={pad.t + 12} class="note">median {median} s</text>
			{
				bins
					.filter((_, i) => i % 2 === 0)
					.map((b) => (
						<text x={x(b.from)} y={H - pad.b + 20} class="tick" text-anchor="middle">
							{b.open ? `${b.from}+` : b.from}
						</text>
					))
			}
			<text x={W - pad.r} y={H - 4} class="tick" text-anchor="end">seconds</text>
		</svg>
		<div class="tip" hidden></div>
	</div>
	<details>
		<summary>Table</summary>
		<table>
			<thead><tr><th>Time</th><th>Decisions</th></tr></thead>
			<tbody>{bins.map((b) => <tr><td>{label(b)}</td><td>{b.n}</td></tr>)}</tbody>
		</table>
	</details>
	<figcaption>
		<slot />
	</figcaption>
</figure>

<style>
	.chart {
		padding: 18px 18px 8px;
		border: 1px solid var(--rule);
		border-radius: 14px;
		background: #fff;
	}
	.fig-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		margin-bottom: 8px;
		font: 600 14.5px/1.3 var(--sans);
		color: var(--ink);
	}
	.sub {
		font-weight: 400;
		color: var(--muted);
	}
	.plot {
		position: relative;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		font-family: var(--sans);
	}
	.grid {
		stroke: var(--rule);
		stroke-width: 1;
	}
	.tick {
		font-size: 12px;
		fill: var(--muted);
	}
	.note {
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--ink);
	}
	.mark {
		fill: var(--accent);
	}
	.hit {
		fill: transparent;
	}
	.col:hover .mark {
		fill: #1f4597;
	}
	.median {
		stroke: var(--ink);
		stroke-width: 1;
	}
	.tip {
		position: absolute;
		pointer-events: none;
		padding: 6px 9px;
		border-radius: 6px;
		background: var(--ink);
		color: #fff;
		font: 500 12.5px/1.2 var(--sans);
		white-space: nowrap;
		transform: translate(-50%, calc(-100% - 8px));
	}
	details {
		margin: 8px 0 0;
		border: 0;
		background: none;
	}
	details > summary {
		padding: 6px 0;
		font: 500 13px/1 var(--sans);
		color: var(--muted);
	}
	details > summary::before {
		display: none;
	}
	details > :not(summary) {
		margin-inline: 0;
	}
	table {
		max-width: 320px;
	}
</style>

<script>
	for (const plot of document.querySelectorAll<HTMLElement>('[data-chart]')) {
		const tip = plot.querySelector<HTMLElement>('.tip')!;
		plot.addEventListener('pointermove', (event) => {
			const col = (event.target as Element).closest<SVGGElement>('.col');
			if (!col) {
				tip.hidden = true;
				return;
			}
			const box = plot.getBoundingClientRect();
			const mark = col.querySelector('.hit')!.getBoundingClientRect();
			tip.textContent = col.dataset.tip!;
			tip.style.left = `${mark.left - box.left + mark.width / 2}px`;
			tip.style.top = `${event.clientY - box.top}px`;
			tip.hidden = false;
		});
		plot.addEventListener('pointerleave', () => (tip.hidden = true));
	}
</script>
