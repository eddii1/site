---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'writing'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">Nothing published yet.</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={`/writing/${post.id}/`}>
						<span class="title">{post.data.title}</span>
						<span class="desc">{post.data.description}</span>
						<span class="info">
							<FormattedDate date={post.data.pubDate} />
							{post.data.wip && <span class="flag">work in progress</span>}
							{post.data.draft && <span class="flag">draft</span>}
						</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}
	li {
		margin: 0;
		border-bottom: 1px solid var(--rule);
	}
	a {
		display: block;
		padding: 22px 0;
		text-decoration: none;
	}
	.title {
		display: block;
		font: 600 22px/1.3 var(--serif);
		color: var(--ink);
		letter-spacing: -0.01em;
	}
	a:hover .title {
		color: var(--accent);
	}
	.desc {
		display: block;
		margin-top: 6px;
		color: var(--muted);
	}
	.info {
		display: flex;
		gap: 12px;
		margin-top: 10px;
		font: 400 13.5px/1 var(--sans);
		color: var(--faint);
	}
	.flag {
		color: var(--warn);
	}
	.empty {
		color: var(--muted);
	}
</style>
