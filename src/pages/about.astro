---
import { SOCIAL_LINKS } from '../consts';
import Page from '../layouts/Page.astro';
---

<Page
	title="About - Eduard Tudoran"
	description="Who Eduard Tudoran is and what he works on."
	back={{ href: '/', label: 'Eduard Tudoran' }}
>
	<h1>About</h1>

	<!-- TODO(Edi): everything below is a starting point. Rewrite it in your own words. -->
	<p>
		I'm Eduard, an applied AI engineer based in Milan. I work on document AI and agent systems,
		and I care most about evaluation: measuring whether an AI system actually does what it claims.
	</p>

	<h2>Now</h2>
	<ul>
		<li>Building agent and evaluation systems at work.</li>
		<li>Writing up side projects and hackathon builds here.</li>
		<li>Studying computer science at the University of Bucharest.</li>
	</ul>

	<h2>Elsewhere</h2>
	<ul>
		{
			SOCIAL_LINKS.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
</Page>

<style>
	h1 {
		padding-top: 48px;
	}
	h2 {
		font-size: 24px;
		margin-top: 48px;
	}
</style>
